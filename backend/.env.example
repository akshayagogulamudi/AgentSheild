# AgentShield AI Backend Environment Variables

# Gemini API Configuration (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=sqlite:///agentshield.db

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ===== NOTIFICATION CONFIGURATION =====

# Notification Mode: 'mock' (default, simulated) or 'live' (actual delivery)
NOTIFICATION_MODE=mock

# Minimum severity to trigger notifications: low, medium, high, critical
NOTIFICATION_MIN_SEVERITY=high

# Deduplication window in minutes (prevent notification storms)
NOTIFICATION_DEDUP_WINDOW_MINUTES=30

# ===== EMAIL CONFIGURATION =====

# SMTP Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Alert recipient(s) - comma-separated for multiple emails
ALERT_EMAIL_TO=security@company.com

# ===== SMS CONFIGURATION (Twilio) =====

# Twilio Account SID and Auth Token
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio Phone Number (your Twilio number)
TWILIO_PHONE_NUMBER=+1234567890

# Alert recipient(s) - comma-separated for multiple numbers
ALERT_PHONE_TO=+1234567890,+0987654321
